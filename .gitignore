# ---- runtime output / logs (regenerated by every run) ----
outputs/
logs/
*.log

# ---- Python ----
__pycache__/
*.py[cod]
.venv*/
venv/

# ---- models, weights, caches (live outside the repo, see README "External dependencies") ----
*.gguf
*.safetensors
*.pth
*.pt
*.ckpt
*.onnx
*.bin
models/
.cache/
huggingface/

# ---- machine-local configuration and secrets ----
config/paths.local.env
config/paths.local.bat
.env
.env.*
*.key
*.pem

# ---- large / personal media that is not part of the demo ----
# ad-hoc recordings dropped in the repo root
/*.mp4
# generated idle-avatar videos (assets/avatar/idle_*.mp4); assets/avatar/idle.mp4 is already tracked, so it is unaffected
*.mp4
# reference-voice candidate recordings (only assets/ref.wav is used)
assets/voice/
# PNG conversion of the avatar image (ComfyUI input), regenerable from the .webp
assets/avatar/*.png
*.7z
*.zip
*.tar.gz
*.rar


# ---- OS / editor ----
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
