# WSL-side paths, sourced by scripts/wsl/*.sh.
# Defaults match the reference machine. To change them, do NOT edit this file:
# copy config/paths.local.example.env to config/paths.local.env (gitignored) and override there.

# Project root, auto-detected from this file's location (works from any clone path, e.g. /mnt/c/.../cyber_gf)
PROJECT_WSL="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Everything below lives in the WSL distro Ubuntu-24.04 (user root). On the reference machine the
# DEFAULT distro is Ubuntu-22.04, where none of these paths exist: always use `wsl -d Ubuntu-24.04`.
WSL_DISTRO=Ubuntu-24.04

# LiveTalking (upstream clone, not part of this repo) - scripts/wsl/lt_install.sh
LT_DIR=/root/livetalking/LiveTalking
LT_VENV=/root/livetalking/LiveTalking/.venv-lt
LT_PORT=8010
LT_AVATAR_ID=wav2lip256_avatar3_WA3       # default; the imood page can pick others per connection (web/avatars.json)
LT_STUN='stun:stun.l.google.com:19302'    # aiortc rejects an empty STUN URI
LT_LOG_DIR=/root/lt_logs
LT_WEIGHTS_ORIG=/root/lt_weights/wav2lip  # wav2lip256 downloads (scripts/wsl/lt_setup_weights.sh)

# Python environments (not part of this repo)
TTS_FAST_VENV=/root/cyber_gf/.venv-tts-fast   # main: faster-whisper + faster-qwen3-tts (scripts/wsl/tts_fast_install.sh)
VOICE_VENV=/root/cyber_gf/.venv-voice         # optional fallback: official qwen-tts 0.1.1 (scripts/wsl/voice_install.sh)
HF_HOME=/root/.cache/huggingface               # Faster-Whisper large-v3 + Qwen3-TTS-12Hz-1.7B-Base

# Legacy question pipeline (Faster-Whisper -> llama.cpp Qwen3 -> Qwen3-TTS, voice_service.py :8020 + llama-server :8090).
# 0 (default) = not started: speech now arrives from the vendor via /cyber_gf/voice (docs/vendor_voice_receiver.md).
# 1 = start it as before (the imood page's record button needs it).
LEGACY_VOICE=0

# machine-local overrides (gitignored)
_LOCAL="$(dirname "${BASH_SOURCE[0]}")/paths.local.env"
[ -f "$_LOCAL" ] && source "$_LOCAL"
unset _LOCAL
