# Copy to config/paths.local.env (gitignored) and uncomment what differs on your machine.
# Sourced at the end of config/paths.env, so anything here overrides the defaults.

# WSL_DISTRO=Ubuntu-24.04
# LT_DIR=/home/me/livetalking/LiveTalking
# LT_VENV=/home/me/livetalking/LiveTalking/.venv-lt
# LT_AVATAR_ID=wav2lip256_myavatar
# LT_LOG_DIR=/home/me/lt_logs
# TTS_FAST_VENV=/home/me/cyber_gf/.venv-tts-fast
# VOICE_VENV=/home/me/cyber_gf/.venv-voice
# HF_HOME=/home/me/.cache/huggingface

# Vendor real-time voice receiver (docs/vendor_voice_receiver.md); must be exported, connections are rejected without it
# export VENDOR_VOICE_TOKEN=change-me
