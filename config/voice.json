{
  "_note": "Voice pipeline settings (test.wav -> Faster-Whisper -> llama.cpp :8090 -> Qwen3-TTS clone -> reply.wav). Paths relative to the project root.",
  "asr": {
    "model": "Systran/faster-whisper-large-v3",
    "device": "cuda",
    "compute_type": "float16",
    "language": "zh",
    "beam_size": 5,
    "vad_filter": false
  },
  "llm": {
    "url": "http://localhost:8090/v1/chat/completions",
    "persona_file": "config/persona.txt",
    "temperature": 1.0,
    "top_p": 0.95,
    "max_tokens": 256
  },
  "tts": {
    "model": "Qwen/Qwen3-TTS-12Hz-1.7B-Base",
    "device": "cuda:0",
    "dtype": "bfloat16",
    "attn_implementation": "sdpa",
    "language": "Chinese",
    "ref_audio": "assets/ref.wav",
    "ref_text_file": "config/ref_text.txt"
  },
  "output_dir": "outputs/voice_test"
}
