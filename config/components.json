  "voice_pipeline": {
    "purpose": "ASR + LLM client + voice-clone TTS",
    "wsl_distro": "Ubuntu-24.04",
    "venv": "/root/cyber_gf/.venv-voice (Python 3.12, torch 2.8.0+cu128)",
    "packages": {
      "qwen-tts": "0.1.1 (https://github.com/QwenLM/Qwen3-TTS)",
