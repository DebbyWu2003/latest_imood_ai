      "wav2lip256_avatar3_WA2": "built from assets/avatar/idle_avatar3_WA2.mp4 (81 frames); white top",
      "wav2lip256_avatar3_BA2": "built from assets/avatar/idle_avatar3_BA2.mp4 (81 frames); black top"
